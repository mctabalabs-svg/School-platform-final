{
  "name": "greenfield-academy-platform",
  "version": "1.0.0",
  "description": "Greenfield Academy School Platform - full-stack backend (Express + PGlite WASM) with Vite SPA middleware, JWT auth, CBC assessments, fees & M-Pesa integration",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file=.env --import=tsx server.ts",
    "start": "node --env-file-if-exists=.env --import=tsx server.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "lucide-react": "^0.546.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  }
}
